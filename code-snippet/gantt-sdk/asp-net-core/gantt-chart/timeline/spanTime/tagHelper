<div style="margin-bottom: 10px;">
    <button id="prevBtn" class="e-btn" style="margin-right: 10px;" onclick="goToPreviousTimeSpan()">Previous Week</button>
    <button id="nextBtn" class="e-btn" onclick="goToNextTimeSpan()">Next Week</button>
</div>
<ejs-gantt id='Gantt' height="430px" dataSource="ViewBag.DataSource" timelineViewMode="Week">
    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" endDate="EndDate" duration="Duration" progress="Progress" parentId="ParentId">
    </e-gantt-taskfields>
    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="Task ID" width="100"></e-gantt-column>
        <e-gantt-column field="TaskName" headerText="Task Name" width="150"></e-gantt-column>
        <e-gantt-column field="StartDate" headerText="Start Date" width="150"></e-gantt-column>
        <e-gantt-column field="Duration" headerText="Duration" width="150"></e-gantt-column>
        <e-gantt-column field="Progress" headerText="Progress" width="150"></e-gantt-column>
    </e-gantt-columns>
</ejs-gantt>
<script>
    function goToPreviousTimeSpan() {
        var gantt = document.getElementById("Gantt").ej2_instances[0];
        gantt.previousTimeSpan();
    }

    function goToNextTimeSpan() {
        var gantt = document.getElementById("Gantt").ej2_instances[0];
        gantt.nextTimeSpan();
    }
</script>