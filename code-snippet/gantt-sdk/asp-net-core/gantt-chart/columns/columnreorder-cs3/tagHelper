<div style="margin-bottom: 15px;">
    <button id="reordersingle" class="e-btn e-info" onclick="reorderSingleColumnUsingFieldName()" style="margin-right: 10px;">Reorder Single Column</button>
    <button id="reordermultiple" class="e-btn e-info" onclick="reorderMultipleColumnsUsingFieldName()">Reorder Multiple Columns</button>
</div>
<ejs-gantt id='Gantt' height="430px" dataSource="ViewBag.DataSource" allowReordering="true" treeColumnIndex="1" splitterSettings="@(new GanttSplitterSettingsModel { Position = "75%" })">
    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" duration="Duration" progress="Progress" parentId="ParentId">
    </e-gantt-taskfields>
    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="Task ID" textAlign="Right" width="90"></e-gantt-column>
        <e-gantt-column field="TaskName" headerText="Task Name" textAlign="Left" width="290"></e-gantt-column>
        <e-gantt-column field="StartDate" headerText="Start Date" textAlign="Right" width="120"></e-gantt-column>
        <e-gantt-column field="Duration" headerText="Duration" textAlign="Right" width="90"></e-gantt-column>
        <e-gantt-column field="Progress" headerText="Progress" textAlign="Right" width="120"></e-gantt-column>
    </e-gantt-columns>
</ejs-gantt>
<script>
    function reorderSingleColumnUsingFieldName() {
        var gantt = document.getElementById("Gantt").ej2_instances[0];
        gantt.reorderColumns('TaskName', 'TaskId');
    }

    function reorderMultipleColumnsUsingFieldName() {
        var gantt = document.getElementById("Gantt").ej2_instances[0];
        gantt.reorderColumns(['TaskName', 'StartDate', 'Duration'], 'TaskId');
    }
</script>