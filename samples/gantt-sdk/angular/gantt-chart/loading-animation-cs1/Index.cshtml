@page
@model CoreSamples.Pages.IndexModel

<ejs-gantt id="Gantt" height="450px" dataSource="ViewBag.DataSource" treeColumnIndex="1" allowSorting="true" allowFiltering="true" allowSelection="true" enableVirtualization="true" highlightWeekends="true">
    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" endDate="EndDate" duration="Duration" progress="Progress" parentID="ParentId">
    </e-gantt-taskfields>
    <e-gantt-columns>
        <e-gantt-column field="TaskId"></e-gantt-column>
        <e-gantt-column field="TaskName"></e-gantt-column>
        <e-gantt-column field="StartDate"></e-gantt-column>
        <e-gantt-column field="Duration"></e-gantt-column>
        <e-gantt-column field="Progress"></e-gantt-column>
    </e-gantt-columns>
    <e-gantt-loadingIndicator indicatorType="Shimmer"></e-gantt-loadingIndicator>
    <e-gantt-labelSettings leftLabel="TaskName" taskLabel="Progress"></e-gantt-labelSettings>
    <e-gantt-splittersettings columnIndex="2"></e-gantt-splittersettings>
</ejs-gantt>
