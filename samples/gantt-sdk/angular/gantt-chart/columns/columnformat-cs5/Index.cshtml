@page
@model CoreSamples.Pages.IndexModel

<ejs-gantt id="Gantt" height="430px" dataSource="ViewBag.DataSource" treeColumnIndex="1">
    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" endDate="EndDate" duration="Duration" progress="Progress" parentID="ParentId">
    </e-gantt-taskfields>
    <e-gantt-splittersettings position="75%"></e-gantt-splittersettings>
    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="Task ID" textAlign="Right" width="90" format="N" type="number"></e-gantt-column>
        <e-gantt-column field="TaskName" headerText="Task Name" textAlign="Left" width="270"></e-gantt-column>
        <e-gantt-column field="StartDate" headerText="Start Date" textAlign="Right" width="120" format="yMd"></e-gantt-column>
        <e-gantt-column field="Duration" headerText="Duration" textAlign="Right" width="90"></e-gantt-column>
        <e-gantt-column field="Progress" headerText="Progress (%)" textAlign="Right" width="120" format="P2"></e-gantt-column>
        <e-gantt-column field="Progress" headerText="Progress ($)" textAlign="Right" width="120" format="C" type="number"></e-gantt-column>
    </e-gantt-columns>
</ejs-gantt>
