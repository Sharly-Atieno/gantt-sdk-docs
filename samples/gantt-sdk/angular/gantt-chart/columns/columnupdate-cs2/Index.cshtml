@page
@model CoreSamples.Pages.IndexModel

<ejs-button id="add" content="Add Column" cssClass="e-info" click="addColumns"></ejs-button>
<ejs-button id="delete" content="Delete Column" cssClass="e-info" click="deleteColumns"></ejs-button>

<ejs-gantt id="Gantt" height="430px" dataSource="ViewBag.DataSource">
    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" endDate="EndDate" duration="Duration" progress="Progress" parentID="ParentId">
    </e-gantt-taskfields>
    <e-gantt-splittersettings position="75%"></e-gantt-splittersettings>
    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="Task ID" textAlign="Right" width="90"></e-gantt-column>
        <e-gantt-column field="TaskName" headerText="Task Name" textAlign="Left" width="270"></e-gantt-column>
        <e-gantt-column field="StartDate" headerText="Start Date" textAlign="Right" width="120"></e-gantt-column>
        <e-gantt-column field="Duration" headerText="Duration" textAlign="Right" width="90"></e-gantt-column>
        <e-gantt-column field="Progress" headerText="Progress" textAlign="Right" width="150"></e-gantt-column>
    </e-gantt-columns>
</ejs-gantt>

<script>
    function addColumns() {
        var gantt = document.getElementById("Gantt").ej2_instances[0];
        var newColumns = [
            { field: 'TaskID', headerText: 'TaskID', width: 120 },
            { field: 'StartDate', headerText: 'StartDate', width: 120, format: 'yMd' }
        ];
        newColumns.forEach(function (col) {
            gantt.treeGrid.grid.columns.push(col);
        });
        gantt.treeGrid.grid.refreshColumns();
    }
    function deleteColumns() {
        var gantt = document.getElementById("Gantt").ej2_instances[0];
        gantt.treeGrid.grid.columns.pop();
        gantt.treeGrid.grid.refreshColumns();
    }
</script>