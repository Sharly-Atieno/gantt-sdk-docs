@page
@model CoreSamples.Pages.IndexModel

<ejs-gantt id="Gantt" height="370px" dataSource="ViewBag.DataSource" treeColumnIndex="1" allowResizing="true">
    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" duration="Duration" progress="Progress" parentID="ParentId">
    </e-gantt-taskfields>
    <e-gantt-splittersettings position="75%"></e-gantt-splittersettings>
    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="Task ID" textAlign="Right" width="90"></e-gantt-column>
        <e-gantt-column field="TaskName" headerText="Task Name" textAlign="Left" width="290" hideAtMedia="(min-width: 700px)"></e-gantt-column>
        <e-gantt-column field="StartDate" headerText="Start Date" textAlign="Right" width="120"></e-gantt-column>
        <e-gantt-column field="Duration" headerText="Duration" textAlign="Right" width="90" hideAtMedia="(max-width: 500px)"></e-gantt-column>
        <e-gantt-column field="Progress" headerText="Progress" textAlign="Right" width="150"></e-gantt-column>
    </e-gantt-columns>
</ejs-gantt>