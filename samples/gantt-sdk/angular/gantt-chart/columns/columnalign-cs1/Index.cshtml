@page
@model CoreSamples.Pages.IndexModel

<ejs-dropdownlist id="alignmentDropdown" dataSource="@(new[] { new { text = "Left", value = "Left" }, new { text = "Right", value = "Right" }, new { text = "Center", value = "Center" }, new { text = "Justify", value = "Justify" } })" fields="@(new { text = "text", value = "value" })" value="Right" change="changeAlignment"></ejs-dropdownlist>

<ejs-gantt id="Gantt" height="370px" dataSource="ViewBag.DataSource">
    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" endDate="EndDate" duration="Duration" progress="Progress" parentID="ParentId">
    </e-gantt-taskfields>
    <e-gantt-splittersettings position="75%"></e-gantt-splittersettings>
    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="Task ID" textAlign="Right" width="90"></e-gantt-column>
        <e-gantt-column field="TaskName" headerText="Task Name" textAlign="Left" width="270"></e-gantt-column>
        <e-gantt-column field="StartDate" headerText="Start Date" textAlign="Right" format="yMd" width="150"></e-gantt-column>
        <e-gantt-column field="Duration" headerText="Duration" textAlign="Right" width="90"></e-gantt-column>
        <e-gantt-column field="Progress" headerText="Progress" textAlign="Right" width="120"></e-gantt-column>
    </e-gantt-columns>
</ejs-gantt>

<script>
    function changeAlignment(args) {
        var alignment = args.value;
        var gantt = document.getElementById("Gantt").ej2_instances[0];
        var columns = gantt.treeGrid.grid.columns;
        columns.forEach(function (col) {
            col.textAlign = alignment;
        });
        gantt.treeGrid.grid.refreshColumns();
    }
</script>