@page
@model CoreSamples.Pages.IndexModel

<ejs-gantt id="Gantt" height="430px" dataSource="ViewBag.DataSource" treeColumnIndex="1">
    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" duration="Duration" progress="Progress" parentID="ParentId" verified="Verified">
    </e-gantt-taskfields>
    <e-gantt-splittersettings position="75%"></e-gantt-splittersettings>
    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="Task ID" textAlign="Right" width="120"></e-gantt-column>
        <e-gantt-column field="TaskName" headerText="Task Name" textAlign="Left" clipMode="EllipsisWithTooltip" width="70"></e-gantt-column>
        <e-gantt-column field="StartDate" headerText="Start Date" textAlign="Right" width="60"></e-gantt-column>
        <e-gantt-column field="Duration" headerText="Duration" textAlign="Right" clipMode="Ellipsis" width="35"></e-gantt-column>
        <e-gantt-column field="Progress" headerText="Progress" textAlign="Right" width="190"></e-gantt-column>
    </e-gantt-columns>
</ejs-gantt>